{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.example/purview/scoring-config.schema.json",
  "title": "Microsoft Purview Score Card configuration",
  "type": "object",
  "required": ["schemaVersion", "model", "dimensions", "collectionProfiles", "collection"],
  "properties": {
    "schemaVersion": { "type": "string", "minLength": 1 },
    "model": {
      "type": "object",
      "required": ["name", "version", "missingEvidencePolicy"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "missingEvidencePolicy": {
          "const": "exclude-from-posture-and-reduce-confidence"
        }
      },
      "additionalProperties": true
    },
    "dimensions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "weight", "metrics"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Z]{3}$" },
          "name": { "type": "string", "minLength": 1 },
          "weight": { "type": "number", "minimum": 0, "maximum": 100 },
          "metrics": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "name", "weight", "minimumProfile", "measurement", "evidence"],
              "properties": {
                "id": { "type": "string", "pattern": "^[A-Z]{3}-[0-9]{2}$" },
                "weight": { "type": "number", "minimum": 0, "maximum": 100 },
                "minimumProfile": { "enum": ["Basic", "Intermediate", "Full"] },
                "measurement": { "enum": ["maturity", "ratio", "hybrid", "manual"] }
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    },
    "collectionProfiles": { "type": "object" },
    "collection": { "type": "object" },
    "manualOverrides": { "type": "object" }
  },
  "additionalProperties": true
}

